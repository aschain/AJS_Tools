# A single .jar file can contain multiple plugins, specified in separate lines.
#
# The format is: <menu>, "<menu label>", <class name>
#
# If something like ("<arg>") is appended to the class name, the setup() method
# will get that as arg parameter; otherwise arg is simply the empty string.

Plugins>AJS, "TwoPhoton Import", ajs.tools.TwoPhoton_Import
Plugins>AJS, "Get 2p Info", ajs.tools.TwoPhoton_Import("printexloc")
Plugins>AJS>Image_Info, "Slicelabel Transfer", ajs.tools.Slicelabel_Transfer
Plugins>AJS>Image_Info, "Slicelabel Editor", ajs.tools.Slicelabel_Editor
Plugins>AJS>Image_Info, "Info Editor", ajs.tools.Slicelabel_Editor("editInfo")
Plugins>AJS>Image_Info, "Print Times", ajs.tools.Time_Extractor("printTimes")
Plugins>AJS, "Diameter Profile", ajs.tools.Diameter_Profile
Plugins>AJS>Measure, "Thresh-Cell-Transfer", ajs.tools.Thresh_Cell_Transfer
Plugins>AJS>Measure, "Run Cellpose on Stack", ajs.tools.AJ_Misc_Plugins("runExternalCellpose")
Plugins>AJS>Measure, "DC Pt Reslice", ajs.tools.Thresh_Cell_Transfer("ptReslice")
Plugins>AJS>Measure, "Copy Stack Roi Means", ajs.tools.AJ_Misc_Plugins("copyStackRoiMeans")
Plugins>AJS>Measure, "GCaMP Data and Figure", ajs.tools.GCaMP_Data
Plugins>AJS>Measure, "Distance From Roi to Labels", ajs.tools.AJ_Misc_Plugins("distanceFromRoiToLabelMap")
Plugins>AJS>Measure, "Masks to Rois", ajs.tools.Thresh_Cell_Transfer("masksToRois")
Plugins>AJS>Adjust, "Stack Trimmer", ajs.tools.StackTrimmer
Plugins>AJS>Adjust, "Normalize Brightness", ajs.tools.AJ_Misc_Plugins("normalizeBrightness")
Plugins>AJS>Adjust, "Image Translator by Pt", ajs.tools.AJ_Misc_Plugins("ptTranslator")
Plugins>AJS>Adjust, "Combine by Pt", ajs.tools.AJ_Misc_Plugins("StackCombiner")
Plugins>AJS>Adjust, "CCR2ConcatChs", ajs.tools.AJ_Misc_Plugins("CCR2ConcatChs")
Plugins>AJS>Adjust, "XYZ-Shift Channel", ajs.tools.AJ_Misc_Plugins("XYZShiftChannel")
Plugins>AJS>Adjust, "Skull Leveler", ajs.tools.Skull_Leveler
Plugins>AJS>Projection, "T Projector", ajs.tools.AJ_Misc_Plugins("TProjector")
Plugins>AJS>Projection, "Z Step Max", ajs.tools.AJ_Misc_Plugins("zStepMax")
Plugins>AJS, "Run AJS-Tools plugin", ajs.tools.AJ_Utils
Plugins>AJS, "AJ Options", ajs.tools.TwoPhoton_Import("options")
Image>Stacks>Tools_, "Concat Chs", ajs.tools.AJ_Misc_Plugins("concatenateChannels")

