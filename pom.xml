<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>43.0.0</version>
		<relativePath />
	</parent>

	<groupId>ajs.tools</groupId>
	<artifactId>AJS_Tools</artifactId>
	<version>0.1.0-SNAPSHOT</version>

	<name>AJS Tools</name>
	<description>A Maven project implementing an ImageJ 1.x plugin.</description>
	<url>http://sites.imagej.net/Aschain</url>
	<inceptionYear>2017</inceptionYear>
	<organization>
		<name>Aaron Schain</name>
		<url>http://sites.imagej.net/Aschain</url>
	</organization>
	<licenses>
		<license>
			<name>Simplified BSD License</name>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>aschain</id>
			<name>Aaron Schain</name>
			<url>http://imagej.net/User:ASchain</url>
			<roles>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Aaron Schain</name>
			<url>http://imagej.net/User:ASchain</url>
			<roles><role>founder</role></roles>
			<properties><id>aschain</id></properties>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>ImageJ Forum</name>
			<archive>http://forum.imagej.net/</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:git://github.com/aschain/AJ_Tools</connection>
		<developerConnection>scm:git:git@github.com:aschain/AJ_Tools</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/aschain/AJ_Tools</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/aschain/AJ_Tools/issues</url>
	</issueManagement>
	<ciManagement>
		<system>None</system>
	</ciManagement>

	<properties>
		<package-name>ajs.tools</package-name>
		<main-class>ajs.tools.TwoPhoton_Import</main-class>
		<license.licenseName>bsd_2</license.licenseName>
		<license.copyrightOwners>Aaron Schain</license.copyrightOwners>
	</properties>
	
	<repositories>
	    <repository>
	      <id>ImageJ-releases</id>
	      <name>ImageJ Releases</name>
	      <url>https://maven.scijava.org/content/repositories/releases/</url>
	    </repository>
		<repository>
			<id>ImageJ-public</id>
			<name>ImageJ Public</name>
			<url>https://maven.scijava.org/content/repositories/public/</url>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
		</dependency>
		<dependency>
			<groupId>org.ejml</groupId>
			<artifactId>ejml-all</artifactId>
			<version>0.41</version>
		</dependency>
		<dependency>
			<groupId>net.haesleinhuepf</groupId>
			<artifactId>clij2_</artifactId>
			<version>2.5.1.4</version>
		</dependency>
		<dependency>
    		<groupId>sc.fiji</groupId>
    		<artifactId>Skeletonize3D_</artifactId>
		</dependency>
		<dependency>
    		<groupId>sc.fiji</groupId>
    		<artifactId>AnalyzeSkeleton_</artifactId>
		</dependency>
	</dependencies>
	
	<build>
		<resources>
			<resource>
				<directory>${basedir}/src/main/resources/</directory>
			</resource>
			<resource>
				<targetPath>src/main/java/</targetPath>
				<directory>${basedir}/src/main/java/</directory>
			</resource>
		</resources>
	</build>
</project>
